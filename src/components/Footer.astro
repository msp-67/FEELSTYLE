---
import { firma } from '../config/firma';
import { navigace } from '../config/navigace';
import { cesta, type Jazyk } from '../i18n';
import T from './T.astro';
import { skryteSluzbyUrl } from '../lib/sluzby';

interface Props {
  jazyk: Jazyk;
}
const { jazyk } = Astro.props;
const nav = navigace[jazyk];
// Odkazy na skryté služby (bez fotky a popisu) vynecháme.
const skryte = await skryteSluzbyUrl();
const sloupce = nav.paticka
  .map((sloupec) => ({ ...sloupec, odkazy: sloupec.odkazy.filter((o) => !skryte.has(o.url)) }))
  .filter((sloupec) => sloupec.odkazy.length > 0);
const rok = new Date().getFullYear();
const adresy = Object.values(firma.adresy);
---

<footer class="paticka">
  <div class="container">
    <div class="paticka__horni">
      <div class="paticka__firma">
        <a href={cesta('/', jazyk)} class="paticka__logo">FEEL STYLE</a>
        {adresy.map((a) => (
          <address>
            <span class="paticka__stitek">{a.nazev}</span>
            {firma.nazev}<br />
            {a.ulice}<br />
            <T text={`${a.psc} ${a.mesto}`} />
          </address>
        ))}
        <div>
          <span class="paticka__stitek">E-mail</span>
          {firma.emaily.kontakt.map((e) => (
            <><a href={`mailto:${e}`}>{e}</a><br /></>
          ))}
        </div>
      </div>

      {sloupce.map((sloupec) => (
        <nav class="paticka__sloupec" aria-label={sloupec.nadpis}>
          <h2 class="paticka__nadpis">{sloupec.nadpis}</h2>
          <ul role="list">
            {sloupec.odkazy.map((o) => (
              <li><a href={cesta(o.url, jazyk)}>{o.nazev}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="paticka__spodni">
      <p>© {rok} {firma.nazev} · IČO {firma.ico} · DIČ {firma.dic}</p>
      <ul role="list" class="paticka__pravni">
        {nav.pravni.map((o) => (
          <li><a href={cesta(o.url, jazyk)}>{o.nazev}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .paticka {
    background: var(--c-ink);
    color: var(--c-paper);
    padding-block: var(--space-9) var(--space-6);
    font-size: var(--fs-sm);
  }
  .paticka a { text-decoration: none; }
  .paticka a:hover { text-decoration: underline; }
  .paticka__horni {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--c-line-on-ink);
  }
  .paticka__firma { display: grid; gap: var(--space-5); grid-column: 1 / -1; align-content: start; }
  @media (min-width: 64em) {
    .paticka__horni { grid-template-columns: 2fr repeat(3, 1fr); }
    .paticka__firma { grid-column: auto; }
  }
  .paticka__logo {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-xl);
    letter-spacing: 0.22em;
  }
  address { font-style: normal; line-height: 1.7; }
  .paticka__stitek, .paticka__nadpis {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--c-muted-on-ink);
  }
  .paticka__nadpis { margin-bottom: var(--space-4); }
  .paticka__sloupec li + li { margin-top: var(--space-2); }
  .paticka__spodni {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    color: var(--c-muted-on-ink);
    font-size: var(--fs-xs);
  }
  .paticka__pravni { display: flex; flex-wrap: wrap; gap: var(--space-5); }
</style>
