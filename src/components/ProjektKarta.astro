---
import { Image } from 'astro:assets';
import type { Projekt } from '../lib/projekty';
import { cesta, t, jazykZUrl } from '../i18n';

interface Props {
  projekt: Projekt;
  /** Šířka karty v layoutu – pro správnou volbu velikosti obrázku. */
  sizes?: string;
  nadpisUroven?: 'h2' | 'h3';
  index?: number;
}
const { projekt, sizes = '(min-width: 64em) 33vw, (min-width: 40em) 50vw, 100vw', nadpisUroven: H = 'h3', index = 0 } = Astro.props;
const jazyk = jazykZUrl(Astro.url);
const s = t(jazyk);
const d = projekt.data;
---

<article class="karta" data-reveal style={`--reveal-delay:${(index % 3) * 90}ms`}>
  <a href={cesta(`/projekty/${projekt.id}`, jazyk)} class="karta__odkaz">
    <div class="karta__foto foto-zoom">
      <Image
        src={d.hlavniFoto}
        alt=""
        widths={[480, 720, 960, 1280]}
        sizes={sizes}
        width={1280}
        height={960}
        fit="cover"
        layout="none"
      />
    </div>
    <div class="karta__text">
      <H class="karta__nazev">{d.nazev}</H>
      <p class="karta__meta">
        {s.typy[d.typ]} · {d.lokalita}{d.zeme !== 'CZ' && `, ${s.zeme[d.zeme]}`}{d.rok && ` · ${d.rok}`}
      </p>
    </div>
  </a>
</article>

<style>
  .karta__odkaz { display: block; text-decoration: none; }
  .karta__foto { aspect-ratio: 4 / 3; background: var(--c-mist); }
  .karta__foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .karta__text { padding-top: var(--space-4); }
  .karta__nazev { font-size: var(--fs-xl); }
  .karta__meta { margin-top: var(--space-1); color: var(--c-muted); font-size: var(--fs-sm); }
  .karta__odkaz:hover .karta__nazev { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
</style>
