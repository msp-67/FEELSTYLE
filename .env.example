# Kontaktní formulář – zkopírujte do .env (lokálně) a nastavte ve Vercel → Settings → Environment Variables.
# Formulář je funkční, pokud je nastaven alespoň jeden kanál (e-mail nebo webhook).

# --- E-mail přes Resend (https://resend.com) ---
RESEND_API_KEY=
# Komu přijde poptávka (více adres oddělte čárkou)
CONTACT_TO=
# Odesílatel – musí být na doméně ověřené v Resend, např. "Web Feel Style <web@feelstyle.cz>"
CONTACT_FROM=

# --- Webhook (Make, Zapier, n8n, CRM…) – dostane JSON s daty formuláře ---
CONTACT_WEBHOOK_URL=
# Volitelné: hodnota se pošle v hlavičce X-Webhook-Secret, aby příjemce ověřil původ
CONTACT_WEBHOOK_SECRET=

# --- Volitelná ochrana Cloudflare Turnstile (bez nich běží honeypot + časová kontrola) ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
